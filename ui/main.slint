import { Button, ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, Dot, Field } from "theme.slint";

/// 时间轴上的一行动作。
export struct ActionRow {
    frame: int,
    kind: string,
    target: string,
    location: string,
    doc: string,
    /// 0 待执行 / 1 对帧中 / 2 已注入 / 3 失败
    status: int,
}

/// 编队绑定面板里的一张卡片。
export struct CardRow {
    index: int,
    role: string,
    available: bool,
    cooling: bool,
    /// 已经绑定到哪个干员；空串表示还没绑。
    bound-to: string,
}

component StatusLight inherits HorizontalLayout {
    in property <string> label;
    in property <bool> ok;
    in property <string> detail;
    spacing: 6px;
    Dot { tint: ok ? Theme.ok : Theme.error; y: (parent.height - 8px) / 2; }
    Text {
        text: label;
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
    Text {
        text: detail;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// 注意：属性不能叫 `row` —— 那是 Rectangle 在网格布局里的保留名。
component TimelineRow inherits Rectangle {
    in property <ActionRow> entry;
    height: 30px;
    background: root.entry.status == 1 ? Theme.panel-alt : transparent;

    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        spacing: Theme.gap;

        Rectangle {
            width: 3px;
            background: root.entry.status == 1 ? Theme.accent
                      : root.entry.status == 2 ? Theme.ok
                      : root.entry.status == 3 ? Theme.error
                      : Theme.idle;
        }
        Text {
            width: 64px;
            text: "F" + root.entry.frame;
            color: root.entry.status == 0 ? Theme.text-dim : Theme.accent;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            width: 72px;
            text: root.entry.kind;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            width: 110px;
            text: root.entry.target;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            width: 72px;
            text: root.entry.location;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: root.entry.doc;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    title: "明日方舟帧级操作复刻器";
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.bg;

    // ——— 输入属性 ———
    in property <bool> ruler-connected;
    in property <string> ruler-profile: "未校准";
    in property <bool> game-found;
    in property <string> battle-state: "—";
    in property <int> cursor-frame;
    in property <int> target-frame: -1;
    in property <string> phase: "空闲";
    in property <string> job-name: "未装载作业";
    in property <string> status-line: "";
    in property <string> log-text: "";
    in property <bool> running;
    in property <bool> can-start;
    in property <[ActionRow]> actions;

    // 编队绑定面板
    in property <bool> binding-visible;
    in property <[CardRow]> cards;
    in property <[string]> unbound-opers;

    // 免责声明
    in property <bool> disclaimer-visible;

    // ——— 回调 ———
    callback load-job();
    callback start-run();
    callback stop-run();
    callback bind-card(int, string);
    callback binding-confirm();
    callback accept-disclaimer();
    callback open-settings();

    VerticalLayout {
        // ——— 顶部状态条 ———
        Rectangle {
            height: 76px;
            background: Theme.panel;
            VerticalLayout {
                padding: Theme.pad;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 18px;
                    StatusLight {
                        label: "尺子";
                        ok: ruler-connected;
                        detail: ruler-connected ? ruler-profile : "未连接";
                    }
                    StatusLight {
                        label: "游戏";
                        ok: game-found;
                        detail: game-found ? battle-state : "未找到窗口";
                    }
                    Rectangle { }
                    Field { label: "阶段"; value: phase; value-color: Theme.accent; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "绝对帧";
                        color: Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: bottom;
                    }
                    Text {
                        text: cursor-frame;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 800;
                    }
                    Text {
                        text: target-frame >= 0 ? "→ " + target-frame : "";
                        color: Theme.accent;
                        font-size: 24px;
                        font-weight: 800;
                    }
                    Rectangle { }
                    Text {
                        text: job-name;
                        color: Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: bottom;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        // ——— 动作时间轴 ———
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                for item in root.actions: TimelineRow { entry: item; }
                if root.actions.length == 0: Rectangle {
                    height: 120px;
                    Text {
                        text: "还没有装载作业。\n点下面的「装载作业」选一个 .json 文件。";
                        color: Theme.text-dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        // ——— 日志 ———
        Rectangle {
            height: 84px;
            background: Theme.panel;
            ScrollView {
                // Rectangle 不是布局容器，显式占满固定高度的日志面板，
                // 否则 ScrollView 会按内容的首选尺寸计算，无法形成可滚动视口。
                width: 100%;
                height: 100%;
                Text {
                    // 给文本绑定视口宽度，换行后的首选高度才能超过视口高度。
                    width: 100%;
                    text: log-text;
                    color: Theme.text-dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // ——— 底部操作条 ———
        Rectangle {
            height: 52px;
            background: Theme.panel;
            HorizontalLayout {
                padding: Theme.pad;
                spacing: Theme.gap;
                alignment: start;

                Button {
                    text: "装载作业";
                    enabled: !running;
                    clicked => { load-job(); }
                }
                Button {
                    text: "开始复刻";
                    primary: true;
                    enabled: can-start && !running;
                    clicked => { start-run(); }
                }
                Button {
                    text: "中止";
                    enabled: running;
                    clicked => { stop-run(); }
                }
                Rectangle { }
                Text {
                    text: status-line;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button {
                    text: "设置";
                    clicked => { open-settings(); }
                }
            }
        }
    }

    // ——— 编队绑定模态 ———
    if binding-visible: Rectangle {
        background: #000000cc;
        Rectangle {
            width: 520px;
            height: 380px;
            background: Theme.panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;

            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.gap;

                Text {
                    text: "编队匹配";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "游戏已停在开局。把作业里的干员和部署栏卡片对应起来 —— "
                        + "之后全程用这一刻的头像做跟踪，不需要再认名字。";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        for card in cards: Rectangle {
                            height: 34px;
                            background: Theme.panel-alt;
                            border-radius: Theme.radius;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    width: 28px;
                                    text: "#" + card.index;
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 56px;
                                    text: card.role;
                                    color: Theme.text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 60px;
                                    text: card.cooling ? "冷却" : (card.available ? "可用" : "费用不足");
                                    color: card.cooling ? Theme.warn : (card.available ? Theme.ok : Theme.text-dim);
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    text: card.bound-to;
                                    placeholder-text: "填入干员名";
                                    edited => { bind-card(card.index, self.text); }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: unbound-opers.length > 0
                        ? "还没绑定：" + unbound-opers.length + " 名干员"
                        : "全部干员已绑定";
                    color: unbound-opers.length > 0 ? Theme.warn : Theme.ok;
                    font-size: 12px;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.gap;
                    Button {
                        text: "确认并开始";
                        primary: true;
                        enabled: unbound-opers.length == 0;
                        clicked => { binding-confirm(); }
                    }
                }
            }
        }
    }

    // ——— 免责声明 ———
    if disclaimer-visible: Rectangle {
        background: #000000e6;
        Rectangle {
            width: 520px;
            height: 300px;
            background: Theme.panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "使用前请阅读";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "本工具通过操作系统的公开接口（屏幕捕获 + 输入注入）操作游戏，"
                        + "不注入游戏进程、不读写游戏内存、不修改游戏文件、不与游戏服务器通信。\n\n"
                        + "即便如此，使用自动化工具仍可能违反游戏的用户协议，"
                        + "由此产生的一切后果由使用者自行承担。\n\n"
                        + "《明日方舟》著作权归上海鹰角网络科技有限公司所有，本项目与其无任何隶属或授权关系。\n\n"
                        + "本程序以 AGPL-3.0-only 授权，分发时必须同时提供完整源代码。";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "我已了解";
                        primary: true;
                        clicked => { accept-disclaimer(); }
                    }
                }
            }
        }
    }
}
